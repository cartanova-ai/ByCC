{
  "name": "qgrid",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel dev",
    "format": "oxlint --type-aware . --fix && oxfmt .",
    "check": "pnpm qgrid-docs:check && oxlint && oxfmt --check .",
    "qgrid-docs:sync": "node scripts/qgrid-doc-consistency.mjs --sync",
    "qgrid-docs:check": "node scripts/qgrid-doc-consistency.mjs",
    "publish:packages": "tsx scripts/publish.ts"
  },
  "devDependencies": {
    "@types/node": "^25",
    "@vitest/coverage-v8": "^4.1.10",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^0.22.1",
    "tsdown": "catalog:",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.7.0"
}
