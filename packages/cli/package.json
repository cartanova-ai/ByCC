{
  "name": "@cartanova/qgrid-cli",
  "version": "2.5.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/cartanova-ai/qgrid"
  },
  "bin": {
    "qgrid": "./dist/cli.js"
  },
  "files": [
    "dist",
    "bundle",
    "postinstall.mjs",
    "skills",
    "README.ko.md"
  ],
  "type": "module",
  "scripts": {
    "bundle": "cd ../api && pnpm build && cd ../cli && rm -rf bundle && mkdir -p bundle/public && touch bundle/.env && cp -r ../api/dist ./bundle/dist && cp -r ../api/web-dist ./bundle/web-dist && cp -r ../api/src ./bundle/src",
    "build": "tsdown",
    "postinstall": "node postinstall.mjs",
    "prepublishOnly": "pnpm run bundle"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/openai": "^3.0.0",
    "@ai-sdk/provider": "^3.0.0",
    "@ai-sdk/provider-utils": "^4.0.0",
    "@anthropic-ai/sdk": "^0.81.0",
    "@better-auth/passkey": "~1.6.0",
    "@better-auth/sso": "~1.6.0",
    "@logtape/logtape": "2.0.0",
    "@logtape/pretty": "2.0.0",
    "@logtape/redaction": "2.0.0",
    "@oxc-project/runtime": "^0.79.0",
    "ai": "^6.0.1",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.6.0",
    "chalk": "^4.1.2",
    "commander": "^13.0.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16",
    "fastify": "^4",
    "ioredis": "^5.8.2",
    "knex": "^3.2.9",
    "pg": "^8.16.3",
    "radashi": "^12.2.0",
