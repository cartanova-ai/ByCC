{
  "id": "RequestLogStep",
  "table": "request_log_steps",
  "title": "RequestLogStep",
  "props": [
    { "name": "id", "type": "integer", "desc": "ID" },
    { "name": "created_at", "desc": "등록일시", "dbDefault": "CURRENT_TIMESTAMP", "type": "date" },
    {
      "type": "relation",
      "name": "request_log",
      "with": "RequestLog",
      "toFilter": true,
      "desc": "부모 request log ID",
      "relationType": "BelongsToOne",
      "onUpdate": "CASCADE",
      "onDelete": "CASCADE"
    },
    { "name": "step_index", "type": "integer", "desc": "ai-sdk step number (0-based)" },
    { "name": "type", "type": "enum", "id": "RequestLogStepType", "desc": "step 타입" },
    {
      "name": "model_name",
      "type": "string",
      "length": 50,
      "nullable": true,
      "desc": "실제 serving 모델"
    },
    {
      "name": "requested_model_name",
      "type": "string",
      "length": 50,
      "nullable": true,
      "desc": "요청 모델 (fallback 전)"
    },
    {
      "name": "fallback_count",
      "type": "integer",
      "nullable": true,
      "desc": "모델 fallback 횟수"
    },
    { "name": "input_tokens", "type": "integer", "nullable": true, "desc": "입력 토큰 (generate)" },
    {
      "name": "output_tokens",
      "type": "integer",
      "nullable": true,
      "desc": "출력 토큰 (generate)"
    },
    { "name": "cache_read_tokens", "type": "integer", "nullable": true, "desc": "캐시 읽기 토큰" },
    {
      "name": "cache_creation_tokens",
      "type": "integer",
      "nullable": true,
      "desc": "캐시 생성 토큰"
    },
    {
      "name": "cache_creation_5m_tokens",
      "type": "integer",
      "nullable": true,
      "desc": "5분 TTL 캐시 생성 토큰"
    },
    {
      "name": "cache_creation_1h_tokens",
      "type": "integer",
      "nullable": true,
      "desc": "1시간 TTL 캐시 생성 토큰"
    },
    { "name": "cost_usd", "type": "integer", "nullable": true, "desc": "step 비용 (micro-USD)" },
    {
      "name": "cost_source",
      "type": "string",
      "length": 20,
      "nullable": true,
      "desc": "비용 출처(provider/pricing_table)"
    },
    { "name": "duration_ms", "type": "integer", "nullable": true, "desc": "소요시간(ms)" },
    { "name": "ttft_ms", "type": "integer", "nullable": true, "desc": "Gen TTFT(ms)" },
    {
      "name": "finish_reason",
      "type": "string",
      "length": 20,
      "nullable": true,
      "desc": "완료 사유"
    },
    {
      "name": "reasoning_text",
      "type": "string",
      "nullable": true,
      "desc": "reasoning 텍스트"
    },
    {
      "name": "reasoning_tokens",
      "type": "integer",
      "nullable": true,
      "desc": "reasoning 토큰 수"
    },
    {
      "name": "tool_call_index",
      "type": "integer",
      "nullable": true,
      "desc": "같은 step 내 tool call 순서"
    },
    {
      "name": "tool_call_id",
      "type": "string",
      "length": 100,
      "nullable": true,
      "desc": "tool call ID"
    },
    { "name": "tool_name", "type": "string", "length": 100, "nullable": true, "desc": "tool 이름" },
    { "name": "tool_args", "type": "string", "nullable": true, "desc": "tool 인자 (JSON string)" },
    {
      "name": "tool_result",
      "type": "string",
      "nullable": true,
      "desc": "tool 결과 (JSON string)"
    },
    {
      "name": "tool_duration_ms",
      "type": "integer",
      "nullable": true,
      "desc": "tool 실행 소요시간(ms)"
    },
    { "name": "error", "type": "string", "nullable": true, "desc": "step 에러 메시지" }
