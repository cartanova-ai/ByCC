{
  "id": "Token",
  "table": "tokens",
  "title": "Token",
  "props": [
    { "name": "id", "type": "integer", "desc": "ID" },
    { "name": "created_at", "type": "date", "desc": "등록일시", "dbDefault": "CURRENT_TIMESTAMP" },
    { "name": "provider", "desc": "프로바이더", "type": "string", "length": 20 },
    {
      "name": "credentials",
      "id": "TokenCredentials",
      "desc": "인증 정보 (JSONB)",
      "type": "json"
    },
    { "name": "name", "desc": "토큰 이름", "type": "string" },
    { "name": "active", "type": "boolean", "desc": "활성 여부", "dbDefault": "true" },
    { "name": "ord", "type": "integer", "desc": "정렬 순서", "dbDefault": "0" },
    {
      "name": "quota_threshold",
      "type": "integer",
      "nullable": true,
      "desc": "quota 사용률 임계치(%). null이면 미설정"
    },
    {
      "name": "weight",
      "type": "integer",
      "desc": "가중 라운드로빈 라우팅 가중치 (1..100)",
      "dbDefault": "1"
    },
    {
      "name": "keepalive_enabled",
      "type": "boolean",
      "desc": "Anthropic 5시간 토큰 윈도우 keepalive 사용 여부",
      "dbDefault": "false"
    }
  ],
  "indexes": [
    {
      "type": "unique",
      "name": "tokens_provider_name_unique",
      "columns": [{ "name": "provider" }, { "name": "name" }],
      "using": "btree"
    }
  ],
  "subsets": {
    "A": [
      "id",
      "created_at",
      "provider",
      "credentials",
      "name",
      "active",
      "ord",
      "quota_threshold",
      "weight",
      "keepalive_enabled"
    ]
  },
  "enums": {
    "TokenOrderBy": { "id-desc": "ID최신순", "ord-asc": "순서순" },
    "TokenSearchField": { "id": "ID", "name": "이름" }
  }
}
